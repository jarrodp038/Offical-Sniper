# Solana Sniper Bot Configuration

# Wallet
PRIVATE_KEY=                          # Base58 encoded private key

# RPC
RPC_ENDPOINT=https://api.mainnet-beta.solana.com
RPC_WEBSOCKET_ENDPOINT=wss://api.mainnet-beta.solana.com
COMMITMENT_LEVEL=confirmed            # processed | confirmed | finalized

# Logger
LOG_LEVEL=info                        # trace | debug | info | warn | error

# Bot Behavior
ONE_TOKEN_AT_A_TIME=true              # Only hold one position at a time

# Transaction Settings
COMPUTE_UNIT_LIMIT=100000
COMPUTE_UNIT_PRICE=421197
PRE_LOAD_EXISTING_MARKETS=false       # Load existing markets on startup
CACHE_NEW_MARKETS=true                # Cache newly discovered markets
TRANSACTION_EXECUTOR=default          # default | warp | jito
CUSTOM_FEE=0.006                      # SOL fee for warp/jito executors

# Buy Settings
QUOTE_MINT=WSOL                       # WSOL | USDC
QUOTE_AMOUNT=0.01                     # Amount in quote token to spend per buy
AUTO_BUY_DELAY=0                      # Delay in ms before buying
MAX_BUY_RETRIES=3                     # Max retries for buy transaction
BUY_SLIPPAGE=10                       # Buy slippage in percent

# Sell Settings
AUTO_SELL=true                        # Automatically sell tokens
MAX_SELL_RETRIES=3                    # Max retries for sell transaction
AUTO_SELL_DELAY=0                     # Delay in ms before selling
PRICE_CHECK_INTERVAL=2000             # Interval in ms to check price
PRICE_CHECK_DURATION=60000            # Duration in ms to monitor price
TAKE_PROFIT=50                        # Take profit percentage
STOP_LOSS=30                          # Stop loss percentage
SELL_SLIPPAGE=10                      # Sell slippage in percent

# Snipe List
USE_SNIPE_LIST=false                  # Only buy tokens in snipe-list.txt
SNIPE_LIST_REFRESH_INTERVAL=5000      # Interval in ms to refresh snipe list

# Filter Settings
FILTER_CHECK_INTERVAL=1000            # Interval in ms between filter checks
FILTER_CHECK_DURATION=10000           # Duration in ms to run filters
CONSECUTIVE_FILTER_MATCHES=3          # Required consecutive passes

# Individual Filters (true/false)
CHECK_IF_MUTABLE=true                 # Check if metadata is mutable
CHECK_IF_SOCIALS=true                 # Check if token has social links
CHECK_IF_MINT_IS_RENOUNCED=true       # Check if mint authority is renounced
CHECK_IF_FREEZABLE=true               # Check if freeze authority exists
CHECK_IF_BURNED=true                  # Check if LP tokens are burned

# Pool Size Filter
MIN_POOL_SIZE=0                       # Min pool size in SOL (0 = disabled)
MAX_POOL_SIZE=0                       # Max pool size in SOL (0 = disabled)
