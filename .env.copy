# Solana Trading Bot Configuration

# ============================================================
# Trading Mode
# ============================================================
# sniper  = monitors new Raydium pools and snipes them
# pattern = trades a fixed list of tokens using chart analysis
TRADING_MODE=pattern

# ============================================================
# Wallet
# ============================================================
PRIVATE_KEY=                          # Base58 encoded private key

# ============================================================
# RPC
# ============================================================
RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
RPC_WEBSOCKET_ENDPOINT=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
COMMITMENT_LEVEL=confirmed            # processed | confirmed | finalized

# ============================================================
# Logger
# ============================================================
LOG_LEVEL=info                        # trace | debug | info | warn | error

# ============================================================
# Quote / Position Sizing (used by both modes)
# ============================================================
QUOTE_MINT=WSOL                       # WSOL | USDC
QUOTE_AMOUNT=0.01                     # Amount per position

# ============================================================
# Transaction Settings
# ============================================================
COMPUTE_UNIT_LIMIT=100000
COMPUTE_UNIT_PRICE=421197
TRANSACTION_EXECUTOR=default          # default | warp | jito
CUSTOM_FEE=0.006                      # SOL fee for warp/jito executors
MAX_BUY_RETRIES=3
MAX_SELL_RETRIES=3
BUY_SLIPPAGE=10
SELL_SLIPPAGE=10

# ============================================================
# PATTERN TRADER MODE (TRADING_MODE=pattern)
# ============================================================
# Comma-separated list of token mint addresses to trade.
# Typically 3 coins. Bot analyzes each chart and trades autonomously.
TRADING_TOKENS=

# How often to sample price and re-analyze (ms)
ANALYSIS_INTERVAL_MS=10000

# Maximum simultaneous open positions across all tracked tokens
MAX_CONCURRENT_POSITIONS=3

# Signal thresholds
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MIN_CONFIDENCE_TO_BUY=60              # 0-100, higher = pickier entries
MIN_CONFIDENCE_TO_SELL=55             # 0-100, higher = hold longer
MIN_CANDLES=30                        # Minimum 1-min candles before signals fire

# Risk management (per position)
PATTERN_TAKE_PROFIT=50                # Sell at +50% gain
PATTERN_STOP_LOSS=25                  # Sell at -25% loss
TRAILING_STOP_PERCENT=15              # Sell on -15% pullback from peak (0 = disabled)
ACTIVATE_TRAILING_AT=20               # Activate trailing only after +20% gain

# ============================================================
# SNIPER MODE (TRADING_MODE=sniper)
# ============================================================
ONE_TOKEN_AT_A_TIME=true
PRE_LOAD_EXISTING_MARKETS=false
CACHE_NEW_MARKETS=true

# Buy timing
AUTO_BUY_DELAY=0

# Auto sell (sniper mode)
AUTO_SELL=true
AUTO_SELL_DELAY=0
PRICE_CHECK_INTERVAL=2000
PRICE_CHECK_DURATION=60000
TAKE_PROFIT=50
STOP_LOSS=30

# Snipe list
USE_SNIPE_LIST=false
SNIPE_LIST_REFRESH_INTERVAL=5000

# Filters
FILTER_CHECK_INTERVAL=1000
FILTER_CHECK_DURATION=10000
CONSECUTIVE_FILTER_MATCHES=3
CHECK_IF_MUTABLE=true
CHECK_IF_SOCIALS=true
CHECK_IF_MINT_IS_RENOUNCED=true
CHECK_IF_FREEZABLE=true
CHECK_IF_BURNED=true
MIN_POOL_SIZE=0
MAX_POOL_SIZE=0
